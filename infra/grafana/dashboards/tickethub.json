{
  "uid": "tickethub-overview",
  "title": "TicketHub overview",
  "tags": ["tickethub"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Seat contention (holds/sec by outcome)",
      "description": "The flash-sale shape. 'won' is capped by seats; 'lost' is everyone the Redis hold turned away before Postgres ever saw them.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(tickethub_holds_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Booking outcomes (per sec by status)",
      "description": "confirmed / cancelled / conflict / unknown. A rising 'unknown' means payments are timing out and the sweep has work to do.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(tickethub_bookings_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Outbox backlog (events owed to the broker)",
      "description": "Should sit at zero. A spike that decays is a broker outage healing; a plateau means the relay is stuck and confirmations are not reaching customers.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "tickethub_outbox_backlog", "legendFormat": "unpublished" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request latency p95 by service",
      "description": "Histogram quantile over the shared http_request_duration_seconds histogram.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "4xx here is mostly healthy: 409 is the system correctly telling a loser they lost.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_request_duration_seconds_count{service=\"gateway\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Catalog cache hit ratio",
      "description": "Hits as a share of hits+misses. BYPASS (cache down, or a parameterised query) is excluded deliberately.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tickethub_cache_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(tickethub_cache_total{result=~\"hit|miss\"}[5m])), 0.0001)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Notifications: sent vs duplicates suppressed",
      "description": "Duplicates are not errors. The outbox publishes at-least-once, so this line is the consumer dedupe doing its job.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(tickethub_notifications_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Sweep recoveries",
      "description": "Paid bookings the reconciling sweep rescued. Every one of these is a customer who kept the seat they paid for.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(tickethub_sweep_recoveries_total)", "legendFormat": "recovered" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Rate limited requests",
      "description": "Requests the gateway rejected with 429.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(tickethub_rate_limited_total)", "legendFormat": "throttled" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Payments by outcome",
      "description": "'replay' climbing means callers are retrying and idempotency is absorbing it - no double charges.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(tickethub_payments_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
